# Server
PORT=5000
NODE_ENV=production

# Required in production — strong random string
JWT_SECRET=change_me_to_long_random_secret

# Admin panel URL (CORS)
FRONTEND_URL=https://admin.yourdomain.com

# Comma-separated allowed origins (admin + mobile web if any)
CORS_ORIGINS=https://admin.yourdomain.com,http://localhost:5173

# Set true behind AWS ALB / nginx reverse proxy
TRUST_PROXY=true
